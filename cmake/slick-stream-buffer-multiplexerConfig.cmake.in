@PACKAGE_INIT@

# Find dependencies.
#
# CONFIG and no FetchContent fallback on purpose: this file runs inside a consumer's
# find_package(), where silently git-cloning and building a dependency is the wrong thing to do -
# it hides a missing install behind a network fetch and can pull a different version than the one
# this package was built and installed against. A missing dependency is reported as a hard error
# instead. Mirrors what slick-stream-buffer and slick-queue do in their own config files.
include(CMakeFindDependencyMacro)
find_dependency(slick-stream-buffer 2.0.0 CONFIG)
find_dependency(slick-queue 2.0.0 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/slick-stream-buffer-multiplexerTargets.cmake")

check_required_components(slick-stream-buffer-multiplexer)
